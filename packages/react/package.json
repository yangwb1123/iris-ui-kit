{
  "name": "@iris-ui-kit/react",
  "version": "0.2.2",
  "description": "React 18/19 adapter for Iris UI — full component set",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "require": "./dist/admin.cjs"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js",
      "require": "./dist/async.cjs"
    },
    "./behaviors": {
      "types": "./dist/behaviors.d.ts",
      "import": "./dist/behaviors.js",
      "require": "./dist/behaviors.cjs"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js",
      "require": "./dist/data.cjs"
    },
    "./error-boundary": {
      "types": "./dist/error-boundary.d.ts",
      "import": "./dist/error-boundary.js",
      "require": "./dist/error-boundary.cjs"
    },
    "./floating": {
      "types": "./dist/floating.d.ts",
      "import": "./dist/floating.js",
      "require": "./dist/floating.cjs"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js",
      "require": "./dist/form.cjs"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "require": "./dist/i18n.cjs"
    },
    "./layouts": {
      "types": "./dist/layouts.d.ts",
      "import": "./dist/layouts.js",
      "require": "./dist/layouts.cjs"
    },
    "./modal-utils": {
      "types": "./dist/modal-utils.d.ts",
      "import": "./dist/modal-utils.js",
      "require": "./dist/modal-utils.cjs"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js",
      "require": "./dist/motion.cjs"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "require": "./dist/provider.cjs"
    },
    "./resource": {
      "types": "./dist/resource.d.ts",
      "import": "./dist/resource.js",
      "require": "./dist/resource.cjs"
    },
    "./skeletons": {
      "types": "./dist/skeletons.d.ts",
      "import": "./dist/skeletons.js",
      "require": "./dist/skeletons.cjs"
    },
    "./skins": {
      "types": "./dist/skins.d.ts",
      "import": "./dist/skins.js",
      "require": "./dist/skins.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    },
    "./undo": {
      "types": "./dist/undo.d.ts",
      "import": "./dist/undo.js",
      "require": "./dist/undo.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@iris-ui-kit/core": "workspace:*",
    "@iris-ui-kit/icons": "workspace:*",
    "@iris-ui-kit/skins": "workspace:*",
    "@iris-ui-kit/theme": "workspace:*",
    "@iris-ui-kit/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yangwb1123/iris-ui-kit.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
