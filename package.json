{
  "name": "iris-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native cross-framework component infrastructure",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=playground --filter=playground-react",
    "dev:vue": "pnpm --filter playground dev",
    "dev:react": "pnpm --filter playground-react dev",
    "dev:cms": "pnpm --filter cms dev",
    "dev:cms-react": "pnpm --filter cms-react dev",
    "dev:cms-solid": "pnpm --filter cms-solid dev",
    "dev:cms-svelte": "pnpm --filter cms-svelte dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:watch": "turbo run dev --concurrency=15",
    "preview": "turbo run preview --concurrency=15",
    "preview:vue": "turbo run preview --filter=playground",
    "preview:react": "turbo run preview --filter=playground-react",
    "test": "turbo run test",
    "bench": "turbo run bench",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "gen:manifest": "pnpm --filter @iris-ui/manifest build && node packages/manifest/dist/generate.js",
    "check:manifest": "pnpm gen:manifest && git diff --exit-code -- packages/manifest/manifest.json packages/manifest/llms.txt",
    "size": "node cli.mjs check-size",
    "check:rsc": "node cli.mjs check-rsc",
    "check:pack-install": "node cli.mjs check-pack-install",
    "check:desktop-parity": "node cli.mjs check-parity",
    "check:framework-parity": "node cli.mjs check-framework",
    "check:tokens": "node cli.mjs check-tokens",
    "cli:acceptance": "node cli.mjs acceptance",
    "cli:harness": "node cli.mjs harness",
    "cli:check": "node cli.mjs check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm gen:manifest && turbo run build && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,vue,svelte,js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,svelte,js,json,md,css,html}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky || true",
    "arch-check": "node scripts/arch-check.mjs --strict",
    "arch-check:ratchet": "node scripts/arch-check.mjs --ratchet",
    "arch-check:baseline": "node scripts/arch-check.mjs --update-baseline",
    "change-budget": "node cli.mjs change-budget",
    "audit:tokens": "node cli.mjs check-tokens",
    "test:coverage": "node cli.mjs check-coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^2.46.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.2",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.16.0",
    "svelte-eslint-parser": "^1.8.0",
    "ts-prune": "^0.10.3",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,json,md,css,html}": [
      "prettier --write"
    ]
  }
}
