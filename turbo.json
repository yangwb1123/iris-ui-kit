{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "size": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "arch-check": {
      "dependsOn": [],
      "cache": false,
      "outputs": []
    },
    "check:rsc": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "cache": false,
      "outputs": []
    },
    "audit:tokens": {
      "dependsOn": [],
      "cache": false,
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": [],
      "cache": false,
      "outputs": []
    },
    "test:coverage:v8": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "check:desktop-parity": {
      "dependsOn": [],
      "cache": false,
      "outputs": []
    },
    "clean": {
      "cache": false
    },

    "ssr-next#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },

    "iris-desktop#build": {
      "dependsOn": ["cms#build", "cms-react#build", "cms-solid#build", "cms-svelte#build"],
      "cache": false
    },
    "iris-desktop#test": {
      "dependsOn": ["cms#build", "cms-react#build", "cms-solid#build", "cms-svelte#build"],
      "cache": false
    },
    "iris-desktop-tauri#build": {
      "dependsOn": ["cms#build", "cms-react#build", "cms-solid#build", "cms-svelte#build"],
      "cache": false
    },
    "iris-desktop-tauri#test": {
      "dependsOn": [
        "iris-desktop-tauri#build",
        "cms#build",
        "cms-react#build",
        "cms-solid#build",
        "cms-svelte#build"
      ],
      "cache": false
    },
    "iris-desktop-wails#build": {
      "dependsOn": ["cms#build", "cms-react#build", "cms-solid#build", "cms-svelte#build"],
      "cache": false
    },
    "iris-desktop-wails#test": {
      "dependsOn": [
        "iris-desktop-wails#build",
        "cms#build",
        "cms-react#build",
        "cms-solid#build",
        "cms-svelte#build"
      ],
      "cache": false
    }
  }
}
