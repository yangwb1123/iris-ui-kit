{
  "name": "ssr-nuxt",
  "version": "0.0.0",
  "private": true,
  "description": "Nuxt 3 SSR smoke app \u2014 the SSR-compat proof for @iris-ui/vue (ROADMAP v3 R14, deferred)",
  "scripts": {
    "dev": "nuxi dev -p 5181",
    "build": "nuxi build",
    "test": "echo \"(ssr-nuxt) build IS the test \u2014 nuxi build server-renders every route\" && exit 0",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.json",
    "clean": "rm -rf .nuxt .output node_modules/.cache"
  },
  "dependencies": {
    "@iris-ui/core": "workspace:*",
    "@iris-ui/theme": "workspace:*",
    "@iris-ui/tokens": "workspace:*",
    "@iris-ui/vue": "workspace:*",
    "nuxt": "^3.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vue-tsc": "^2.1.10"
  }
}
