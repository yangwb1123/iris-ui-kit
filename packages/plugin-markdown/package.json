{
  "name": "@iris-ui-kit/plugin-markdown",
  "version": "0.1.0",
  "description": "Safe structured-node Markdown renderer for Iris UI across react/vue/solid/svelte",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js",
      "require": "./dist/solid/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/clean-plugin-dist.mjs && tsup && svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json && node ../../scripts/prune-package-dist.mjs dist/svelte",
    "test": "vitest run -c vitest.main.config.ts && vitest run -c vitest.solid.config.ts && vitest run -c vitest.svelte.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.solid.json --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo .svelte-kit"
  },
  "dependencies": {
    "@iris-ui-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/svelte": "^5.2.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vue/test-utils": "^2.4.6",
    "esbuild-plugin-solid": "^0.6.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solid-js": "^1.9.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tsup": "^8.3.5",
    "vite-plugin-solid": "^2.11.0",
    "vue": "^3.5.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nousresearch/iris-ui.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
