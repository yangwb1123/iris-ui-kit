{
  "name": "cms-react",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@iris-ui-kit/cms-shared": "workspace:*",
    "@iris-ui-kit/core": "workspace:*",
    "@iris-ui-kit/plugin-form-builder": "workspace:^",
    "@iris-ui-kit/plugin-locale-zh": "workspace:^",
    "@iris-ui-kit/plugin-markdown": "workspace:^",
    "@iris-ui-kit/plugin-notifications": "workspace:^",
    "@iris-ui-kit/plugin-pro-table": "workspace:^",
    "@iris-ui-kit/react": "workspace:*",
    "@iris-ui-kit/tokens": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^8.2.0"
  }
}
