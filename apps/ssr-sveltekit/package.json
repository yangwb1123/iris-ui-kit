{
  "name": "ssr-sveltekit",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit SSR smoke app — the SSR-compat proof for @iris-ui-kit/svelte (ROADMAP v3 R14, deferred)",
  "scripts": {
    "dev": "vite dev --port 5182",
    "build": "vite build",
    "test": "vitest run --config vitest.ssr.config.ts && vitest run --config vitest.hydrate.config.ts",
    "typecheck": "svelte-check",
    "clean": "rm -rf .svelte-kit build node_modules/.cache"
  },
  "dependencies": {
    "@iris-ui-kit/core": "workspace:*",
    "@iris-ui-kit/svelte": "workspace:*",
    "@iris-ui-kit/theme": "workspace:*",
    "@iris-ui-kit/tokens": "workspace:*",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.16.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "svelte-check": "^4.1.0",
    "typescript": "^5.6.3"
  },
  "type": "module"
}
