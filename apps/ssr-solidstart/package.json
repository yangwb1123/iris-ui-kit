{
  "name": "ssr-solidstart",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "description": "SolidStart file-routed SSR reference app for @iris-ui-kit/solid",
  "scripts": {
    "dev": "vinxi dev --port 5183",
    "build": "vinxi build",
    "test": "vitest run && node --test test/production-routes.node.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test app.config.ts vitest.config.ts",
    "format:check": "prettier --check src scripts test app.config.ts vitest.config.ts package.json",
    "clean": "rm -rf .output node_modules/.cache"
  },
  "dependencies": {
    "@iris-ui-kit/core": "workspace:*",
    "@iris-ui-kit/solid": "workspace:*",
    "@iris-ui-kit/theme": "workspace:*",
    "@iris-ui-kit/tokens": "workspace:*",
    "@solidjs/router": "^0.16.1",
    "@solidjs/start": "^1.1.0",
    "solid-js": "^1.9.0",
    "vinxi": "^0.5.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.14"
  }
}
