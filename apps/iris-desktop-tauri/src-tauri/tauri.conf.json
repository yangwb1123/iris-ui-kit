{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iris Desktop OS",
  "version": "0.1.0",
  "identifier": "com.iris-ui.desktop-os",
  "build": {
    "beforeDevCommand": "pnpm --filter desktop-os dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm --filter desktop-os build",
    "frontendDist": "../desktop-os/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Iris Desktop OS",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
