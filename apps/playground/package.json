{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@iris-ui-kit/core": "workspace:^",
    "@iris-ui-kit/plugin-calendar": "workspace:^",
    "@iris-ui-kit/plugin-charts": "workspace:^",
    "@iris-ui-kit/plugin-markdown": "workspace:^",
    "@iris-ui-kit/tokens": "workspace:*",
    "@iris-ui-kit/vue": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^5.4.11",
    "vue-tsc": "^3.3.8"
  }
}
