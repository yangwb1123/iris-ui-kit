{
  "name": "@iris-ui-kit/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Iris UI — query the typed component manifest (list / search / get-api / scaffold) so agents call components correctly across 4 frameworks",
  "license": "MIT",
  "engines": {
    "node": "^20.9.0 || >=22.0.0"
  },
  "type": "module",
  "bin": {
    "iris-ui-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@iris-ui-kit/manifest": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nousresearch/iris-ui.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
