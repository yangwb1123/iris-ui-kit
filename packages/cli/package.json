{
  "name": "@iris-ui-kit/cli",
  "version": "0.0.0",
  "description": "Command-line scaffolding tool for Iris UI — list components and generate ready-to-paste usage snippets",
  "license": "MIT",
  "type": "module",
  "bin": {
    "iris-ui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@iris-ui-kit/manifest": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nousresearch/iris-ui.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
