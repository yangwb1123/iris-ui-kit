{
  "name": "ssr-nuxt",
  "version": "0.0.0",
  "private": true,
  "description": "Nuxt 3 SSR smoke app — the SSR-compat proof for @iris-ui-kit/vue (ROADMAP v3 R14, deferred)",
  "scripts": {
    "dev": "nuxi dev -p 5181",
    "build": "nuxi build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.json",
    "clean": "rm -rf .nuxt .output node_modules/.cache"
  },
  "dependencies": {
    "@iris-ui-kit/core": "workspace:*",
    "@iris-ui-kit/theme": "workspace:*",
    "@iris-ui-kit/tokens": "workspace:*",
    "@iris-ui-kit/vue": "workspace:*",
    "nuxt": "^3.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vue-tsc": "^2.1.10"
  }
}
