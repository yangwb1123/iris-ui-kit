{
  "name": "@iris-ui-kit/eslint-plugin",
  "version": "0.2.0",
  "description": "ESLint plugin for Iris UI consumers — enforce correct import paths, provider usage, and plugin registration",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "@types/eslint": "^9.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yangwb1123/iris-ui-kit.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
