{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iris CMS Tauri",
  "version": "0.1.0",
  "identifier": "dev.iris-ui.desktop-tauri",
  "build": {
    "frontendDist": "../dist/react"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Iris CMS desktop shell (Tauri)",
    "longDescription": "Hosts the Iris UI CMS (React/Vue/Solid/Svelte) in one native Tauri window with a live framework switcher and native save/clipboard bridges.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
