{
  "name": "@iris-ui/solid",
  "version": "0.0.0",
  "description": "SolidJS adapter for Iris UI — thin bridges over @iris-ui/core",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@iris-ui/core": "workspace:*",
    "@iris-ui/icons": "workspace:*",
    "@iris-ui/skins": "workspace:*",
    "@iris-ui/theme": "workspace:*",
    "@iris-ui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "esbuild-plugin-solid": "^0.6.0",
    "jsdom": "^25.0.1",
    "solid-js": "^1.9.3",
    "tsup": "^8.3.5",
    "vite-plugin-solid": "^2.11.0"
  }
}
