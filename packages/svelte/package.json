{
  "name": "@iris-ui-kit/svelte",
  "version": "0.2.0",
  "description": "Svelte 5 adapter for Iris UI — thin bridges over @iris-ui-kit/core",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "svelte": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "svelte": "./dist/async/index.js",
      "default": "./dist/async/index.js"
    },
    "./behaviors": {
      "types": "./dist/behaviors/index.d.ts",
      "svelte": "./dist/behaviors/index.js",
      "default": "./dist/behaviors/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "svelte": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./error-boundary": {
      "types": "./dist/error-boundary/index.d.ts",
      "svelte": "./dist/error-boundary/index.js",
      "default": "./dist/error-boundary/index.js"
    },
    "./floating": {
      "types": "./dist/floating/index.d.ts",
      "svelte": "./dist/floating/index.js",
      "default": "./dist/floating/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "svelte": "./dist/form/index.js",
      "default": "./dist/form/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "svelte": "./dist/i18n/index.js",
      "default": "./dist/i18n/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "svelte": "./dist/layouts/index.js",
      "default": "./dist/layouts/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "svelte": "./dist/motion/index.js",
      "default": "./dist/motion/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "svelte": "./dist/provider/index.js",
      "default": "./dist/provider/index.js"
    },
    "./resource": {
      "types": "./dist/resource/index.d.ts",
      "svelte": "./dist/resource/index.js",
      "default": "./dist/resource/index.js"
    },
    "./skeletons": {
      "types": "./dist/skeletons/index.d.ts",
      "svelte": "./dist/skeletons/index.js",
      "default": "./dist/skeletons/index.js"
    },
    "./skins": {
      "types": "./dist/skins/index.d.ts",
      "svelte": "./dist/skins/index.js",
      "default": "./dist/skins/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "svelte": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./undo": {
      "types": "./dist/undo/index.d.ts",
      "svelte": "./dist/undo/index.js",
      "default": "./dist/undo/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist && node ../../scripts/prune-package-dist.mjs dist && node scripts/fix-esm-extensions.mjs",
    "dev": "svelte-package -i src -o dist --watch",
    "test": "vitest run && vitest run --config vitest.ssr.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo .svelte-kit"
  },
  "dependencies": {
    "@iris-ui-kit/core": "workspace:*",
    "@iris-ui-kit/icons": "workspace:*",
    "@iris-ui-kit/skins": "workspace:*",
    "@iris-ui-kit/theme": "workspace:*",
    "@iris-ui-kit/tokens": "workspace:*",
    "@floating-ui/dom": "^1.8.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.2.6",
    "jsdom": "^25.0.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.1.1",
    "vite": "^8.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nousresearch/iris-ui.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
