    "@iris-ui-kit/skins": "workspace:*",
    "@iris-ui-kit/core": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^8.1.5"
  }
}
