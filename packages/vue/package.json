{
  "name": "@iris-ui/vue",
  "version": "0.0.0",
  "description": "Vue 3 adapter for Iris UI (theme + machine bridge)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@iris-ui/core": "workspace:*",
    "@iris-ui/icons": "workspace:*",
    "@iris-ui/theme": "workspace:*",
    "@iris-ui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "vue": "^3.5.13"
  }
}
