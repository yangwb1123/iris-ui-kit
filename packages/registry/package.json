{
  "name": "@iris-ui-kit/registry",
  "version": "0.1.0",
  "description": "Typed source registry and declarative marketplace contracts for Iris UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yangwb1123/iris-ui-kit.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
