+// MIT. Package-name matching only; no recursive braces AST or expansion API.
+'use strict';
+const picomatch = require('picomatch');
+
+function compile(pattern) {
+  if (typeof pattern !== 'string' || pattern.length > 4096) {
+    throw new RangeError('Changesets pattern budget exceeded');
+  }
+  let depth = 0;
+  let inClass = false;
+  for (let i = 0; i < pattern.length; i++) {
+    const char = pattern[i];
+    if (char === '\\') { i++; continue; }
+    if (char === '[') { inClass = true; continue; }
+    if (char === ']') { inClass = false; continue; }
+    if (inClass) continue;
+    if (char === '{' || char === '(') depth++;
+    if (depth > 64) throw new RangeError('Changesets pattern budget exceeded');
+    if (char === '}' || char === ')') depth = Math.max(0, depth - 1);
+  }
+  return picomatch(pattern, {}, true);
+}
+
+function matchNames(names, patterns) {
+  const included = new Set();
+  const excluded = new Set();
+  let negatives = 0;
+  for (const pattern of patterns) {
+    const match = compile(pattern);
+    const negative = match.state.negated || match.state.negatedExtglob;
+    if (negative) negatives++;
+    for (const name of names) {
+      const result = match(name, true);
+      if (negative ? result.isMatch : !result.isMatch) continue;
+      if (negative) excluded.add(name);
+      else { excluded.delete(name); included.add(name); }
+    }
+  }
+  const selected = patterns.length && negatives === patterns.length ? names : [...included];
+  return selected.filter(name => !excluded.has(name));
+}
+matchNames.isMatch = (name, pattern) => compile(pattern)(name);
+module.exports = matchNames;
