{
  "name": "desktop-os-svelte",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo .svelte-kit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@iris-ui-kit/core": "workspace:*",
    "@iris-ui-kit/svelte": "workspace:*",
    "@iris-ui-kit/tokens": "workspace:*",
    "svelte": "^5.56.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "jsdom": "^25.0.1",
    "svelte-check": "^4.1.1",
    "vite": "^8.2.1",
    "vitest": "3.2.6"
  }
}
