{
  "name": "@iris-ui/svelte",
  "version": "0.0.0",
  "description": "Svelte 5 adapter for Iris UI — thin bridges over @iris-ui/core",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./undo": {
      "types": "./dist/undo/index.d.ts",
      "default": "./dist/undo/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist && node scripts/fix-esm-extensions.mjs",
    "dev": "svelte-package -i src -o dist --watch",
    "test": "vitest run && vitest run --config vitest.ssr.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo .svelte-kit"
  },
  "dependencies": {
    "@iris-ui/core": "workspace:*",
    "@iris-ui/icons": "workspace:*",
    "@iris-ui/skins": "workspace:*",
    "@iris-ui/theme": "workspace:*",
    "@iris-ui/tokens": "workspace:*",
    "@floating-ui/dom": "^1.7.6"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/svelte": "^5.2.6",
    "jsdom": "^25.0.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "vite": "^5.4.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nousresearch/iris-ui.git"
  }
}
