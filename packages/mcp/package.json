{
  "name": "@iris-ui/mcp",
  "version": "0.0.0",
  "description": "Model Context Protocol server for Iris UI — query the typed component manifest (list / search / get-api / scaffold) so agents call components correctly across 4 frameworks",
  "license": "MIT",
  "type": "module",
  "bin": {
    "iris-ui-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@iris-ui/manifest": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  }
}
