{
  "name": "iris-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native cross-framework component infrastructure",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=playground --filter=playground-react",
    "dev:vue": "pnpm --filter playground dev",
    "dev:react": "pnpm --filter playground-react dev",
    "dev:cms": "pnpm --filter cms dev",
    "dev:cms-react": "pnpm --filter cms-react dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:watch": "turbo run dev --concurrency=15",
    "preview": "turbo run preview --concurrency=15",
    "preview:vue": "turbo run preview --filter=playground",
    "preview:react": "turbo run preview --filter=playground-react",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "gen:manifest": "pnpm --filter @iris-ui/manifest build && node packages/manifest/dist/generate.js",
    "check:manifest": "pnpm gen:manifest && git diff --exit-code -- manifest.json llms.txt packages/manifest/manifest.json packages/manifest/llms.txt",
    "size": "node scripts/check-size.mjs",
    "check:rsc": "node scripts/check-rsc-directive.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm gen:manifest && turbo run build && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,json,md,css,html}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "axe-core": "^4.10.0",
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "vue-eslint-parser": "^9.4.3",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,json,md,css,html}": [
      "prettier --write"
    ]
  }
}
